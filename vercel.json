{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ],
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python",
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
